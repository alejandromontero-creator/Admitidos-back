              "pm.test(\"Responde 200\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Nombre actualizado\", () => pm.expect(pm.response.json().data.nombre).to.eql(\"Programa Postman EDITADO\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Programa Postman EDITADO\",\n  \"facultad\": \"{{facultadId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/programas/update/{{programaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "programas",
