{
  "info": {
    "name": "Admitidos Back - Facultades y Programas",
    "description": "Recorrido completo. Ejecutar en orden (Run collection). Crea datos de prueba y los borra al final.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "facultadId",
      "value": ""
    },
    {
      "key": "programaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Health (¿la API está viva?)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.expect(pm.response.code).to.eql(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "01 - Facultades: crear (guarda facultadId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.expect(pm.response.code).to.eql(201));",
              "const d = pm.response.json().data;",
              "pm.collectionVariables.set(\"facultadId\", d._id);",
              "pm.test(\"Se guardó facultadId\", () => pm.expect(!!d._id).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Facultad de Prueba Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/facultades/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "facultades",
            "create"
          ]
        }
      }
    },
    {
      "name": "02 - Facultades: listar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Incluye la facultad creada\", () => pm.expect(pm.response.json().data.some(f => f._id === pm.collectionVariables.get(\"facultadId\"))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/facultades/show/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "facultades",
            "show"
          ]
        }
      }
    },
    {
      "name": "03 - Programas: crear (guarda programaId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.expect(pm.response.code).to.eql(201));",
              "const d = pm.response.json().data;",
              "pm.collectionVariables.set(\"programaId\", d._id);",
              "pm.test(\"Tiene nombre y facultad\", () => { pm.expect(d.nombre).to.eql(\"Programa de Prueba Postman\"); pm.expect(d.facultad).to.eql(pm.collectionVariables.get(\"facultadId\")); });",
              "pm.test(\"Tiene createdAt y updatedAt\", () => pm.expect(!!d.createdAt && !!d.updatedAt).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Programa de Prueba Postman\",\n  \"facultad\": \"{{facultadId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/programas/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "programas",
            "create"
          ]
        }
      }
    },
    {
      "name": "04 - Programas: listar todos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Incluye el programa creado\", () => pm.expect(pm.response.json().data.some(p => p._id === pm.collectionVariables.get(\"programaId\"))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/programas/show/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "programas",
            "show"
          ]
        }
      }
    },
    {
      "name": "05 - Programas: filtrar por facultad",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Solo trae programas de esa facultad\", () => { const lista = pm.response.json().data; pm.expect(lista.length > 0 && lista.every(p => p.facultad._id === pm.collectionVariables.get(\"facultadId\"))).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/programas/show/?facultad={{facultadId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "programas",
            "show"
          ],
          "query": [
            {
              "key": "facultad",
              "value": "{{facultadId}}"
            }
          ]
        }
      }
    },
    {
      "name": "06 - Programas: ver uno",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Trae el nombre de la facultad\", () => pm.expect(pm.response.json().data.facultad.nombre).to.eql(\"Facultad de Prueba Postman\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/programas/info/{{programaId}}",
          "host": [
            "{{baseUrl}}"
